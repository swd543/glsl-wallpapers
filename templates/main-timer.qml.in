import QtQuick
import org.kde.plasma.plasmoid

WallpaperItem {
    id: root

    // Intentionally slow scene: repaint at 2 fps instead of the compositor's
    // render loop. Each tick advances the shader time by 0.5 s of real time,
    // so the animation is sampled twice a second and moves a deliberate,
    // choppy step per frame. The QSB shader is stateless, so sampling at 2
    // fps is lossless for the look - and costs ~30x less GPU duty.
    property int tick: 0

    Timer {
        interval: 500
        running: root.visible
        repeat: true
        onTriggered: tick += 1
    }

    ShaderEffect {
        id: shader

        anchors.fill: parent
        blending: false

        property real renderScale: @RENDER_SCALE@
        property real time: tick * 0.5
        property vector2d resolution: Qt.vector2d(
            Math.max(width * renderScale, 1),
            Math.max(height * renderScale, 1))

        fragmentShader: Qt.resolvedUrl("@SHADER@")

        layer.enabled: renderScale < 0.999
        layer.textureSize: Qt.size(
            Math.max(1, Math.round(width * renderScale)),
            Math.max(1, Math.round(height * renderScale)))
        layer.live: true
        layer.smooth: true
        layer.mipmap: false
    }
}
