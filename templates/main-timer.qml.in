import QtQuick
import org.kde.plasma.plasmoid

WallpaperItem {
    id: root

    // Intentionally slow scene: repaint at a low fixed rate instead of the
    // compositor's render loop. Each tick advances the shader time by
    // @TICK_SECONDS@ s of real time (interval @TICK_MS@ ms), so the animation
    // is sampled a few times per second and moves a deliberate step per
    // frame. The QSB shader is stateless, so low-rate sampling is lossless
    // for the look - and costs tens of times less GPU duty.
    property int tick: 0

    Timer {
        interval: @TICK_MS@
        running: root.visible
        repeat: true
        onTriggered: tick += 1
    }

    ShaderEffect {
        id: shader

        anchors.fill: parent
        blending: false

        property real renderScale: @RENDER_SCALE@
        property real time: tick * @TICK_SECONDS@
        property vector2d resolution: Qt.vector2d(
            Math.max(width * renderScale, 1),
            Math.max(height * renderScale, 1))

        fragmentShader: Qt.resolvedUrl("@SHADER@")

        layer.enabled: renderScale < 0.999
        layer.textureSize: Qt.size(
            Math.max(1, Math.round(width * renderScale)),
            Math.max(1, Math.round(height * renderScale)))
        layer.live: true
        layer.smooth: true
        layer.mipmap: false
    }
}
