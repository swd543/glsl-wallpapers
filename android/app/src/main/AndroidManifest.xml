<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <service
            android:name=".InkWallpaperService"
            android:label="@string/wall_ink"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_ink" />
        </service>

        <service
            android:name=".InkMelancholyWallpaperService"
            android:label="@string/wall_ink_melancholy"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_ink_melancholy" />
        </service>

        <service
            android:name=".CausticsWallpaperService"
            android:label="@string/wall_caustics"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_caustics" />
        </service>

        <activity
            android:name=".InkSettingsActivity"
            android:label="@string/wall_ink"
            android:exported="true" />

        <activity
            android:name=".InkMelancholySettingsActivity"
            android:label="@string/wall_ink_melancholy"
            android:exported="true" />

        <activity
            android:name=".CausticsSettingsActivity"
            android:label="@string/wall_caustics"
            android:exported="true" />
    </application>
</manifest>
