# build/ is regenerated by scripts/build-packages.sh
build/

# Compiled shader binaries — build artifacts, regenerated by
# scripts/compile-qsb.sh (never hand-edit, never commit)
*.qsb

# host-specific local tooling (not part of the repo)
revert/

__pycache__/
*.pyc

# Android: build output + generated shader assets (regenerated by
# android/scripts/generate-assets.sh — derived files, never hand-edited)
android/.gradle/
android/app/build/
android/app/src/main/assets/shaders/
